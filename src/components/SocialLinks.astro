---
import { site } from "../data/site";

const { class: className = "" } = Astro.props;
const socialLinks = Object.entries(site.social).filter(([, url]) => url);
const labels: Record<string, string> = {
  facebook: "Facebook",
  instagram: "Instagram",
  linkedin: "LinkedIn",
  youtube: "YouTube",
};
---

{
  socialLinks.length > 0 && (
    <ul class:list={["social-links", className]} aria-label="Legacy Beacon social media">
      {socialLinks.map(([network, url]) => (
        <li>
          <a
            class={`social-${network}`}
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="social_click"
            aria-label={`${labels[network] ?? network} — opens in a new tab`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {network === "instagram" && (
                <>
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4.25" />
                  <circle class="social-icon-dot" cx="17.4" cy="6.7" r="1" />
                </>
              )}
              {network === "facebook" && (
                <path d="M14.25 21v-8h2.7l.4-3.1h-3.1V7.92c0-.9.25-1.52 1.55-1.52h1.66V3.63c-.29-.04-1.27-.13-2.42-.13-2.4 0-4.04 1.46-4.04 4.15V9.9H8.3V13H11v8h3.25Z" />
              )}
              {network === "linkedin" && (
                <>
                  <rect x="4" y="9" width="3.5" height="11" rx=".5" />
                  <circle cx="5.75" cy="5.75" r="1.9" />
                  <path d="M10 9h3.35v1.5c.8-1.15 2.05-1.85 3.7-1.85 3.15 0 3.95 2.07 3.95 4.77V20h-3.5v-5.84c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.52-2.25 3.1V20H10V9Z" />
                </>
              )}
              {network === "youtube" && (
                <>
                  <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
                  <path class="social-icon-fill" d="m10 9 5 3-5 3V9Z" />
                </>
              )}
            </svg>
            <span>{labels[network] ?? network}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
