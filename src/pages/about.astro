---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Us"
  description="Learn how Legacy Beacon helps families and entrepreneurs build financial freedom through education, mentorship, and purpose-driven strategies."
>
  <section class="about-hero" aria-labelledby="about-title">
    <div class="container about-hero-grid">
      <div class="about-hero-copy">
        <p class="about-kicker">Who We Are</p>
        <h1 id="about-title">About <span>Legacy Beacon</span></h1>
        <p>
          Legacy Beacon helps families and individuals explore practical ways to
          protect what matters most and build long-term financial confidence
          through education, conversation, and tailored guidance.
        </p>
        <p>
          We believe financial clarity begins with understanding. Our role is to
          simplify complex decisions, encourage informed conversations, and help
          clients build a plan that aligns with their goals, responsibilities,
          and long-term priorities.
        </p>
        <div class="notice" role="note">
          <strong>Important:</strong> The information shared on this website is
          educational in nature and is not legal, tax, or investment advice.
        </div>
        <a class="btn btn-primary about-hero-cta" href="/contact">
          Book a free consultation
        </a>
      </div>
      <figure class="about-hero-image">
        <img
          src="/images/about-family.webp"
          alt="A grandmother and child creating something together"
          width="800"
          height="800"
        />
      </figure>
    </div>
  </section>

  <section class="about-direction" aria-labelledby="direction-title">
    <div class="container">
      <div class="about-section-heading">
        <h2 id="direction-title">Our Vision &amp; Mission</h2>
      </div>
      <div class="about-direction-grid">
        <article>
          <span class="about-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
          </span>
          <h3>Our Vision</h3>
          <p>
            To see families across communities living free from financial
            stress, thriving in purpose, and equipped to pass down wealth,
            wisdom, and values from one generation to the next.
          </p>
        </article>
        <article>
          <span class="about-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 4v16M19 4v16M2 9h20M8 6l-3 3 3 3M16 6l3 3-3 3"/></svg>
          </span>
          <h3>Our Mission</h3>
          <p>
            To educate, mentor, and guide families toward financial independence
            and legacy creation through simple, smart, and sustainable
            strategies — turning clarity into action and action into impact.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-story" aria-labelledby="story-title">
    <div class="container about-story-grid">
      <div class="about-story-heading">
        <p class="about-kicker">Our Story</p>
        <h2 id="story-title">
          From Financial Confusion to Clarity — For Every Family
        </h2>
      </div>
      <div class="about-story-copy">
        <p>
          Legacy Beacon LLC was founded on a simple truth:
          <strong>when families feel financially secure, they can focus on what
          matters most.</strong> We began with a passion to bridge the gap between
          financial uncertainty and confident decision-making so that more people
          can move forward with clarity.
        </p>
        <p>
          Today, we serve families and entrepreneurs with education, mentorship,
          and practical protection strategies that turn uncertainty into
          confidence and planning into progress. Our approach is thoughtful,
          human, and purpose-driven — built to help you protect what matters and
          build what lasts.
        </p>
        <p class="about-story-note">
          <strong>What guides us:</strong> empowering decisions, simple
          strategies, and a legacy mindset — so every step you take today
          strengthens tomorrow.
        </p>
      </div>
    </div>
  </section>

  <section class="about-values" aria-labelledby="values-title">
    <div class="container">
      <div class="about-values-intro">
        <div>
          <h2 id="values-title">Our Core Values</h2>
        </div>
        <p>
          We stand on principles that protect what matters most and build what
          lasts — so every decision moves your family closer to freedom,
          purpose, and impact.
        </p>
      </div>
      <div class="about-values-grid">
        <article><span class="about-value-icon">◇</span><h3>Faith &amp; Integrity</h3><p>We lead with honesty, transparency, and a commitment to doing what’s right for every family.</p></article>
        <article><span class="about-value-icon">○</span><h3>Education &amp; Empowerment</h3><p>We simplify complex topics and equip you to make confident, informed financial decisions.</p></article>
        <article><span class="about-value-icon">⌂</span><h3>Family &amp; Community</h3><p>We strengthen households first — because strong families build thriving communities.</p></article>
        <article><span class="about-value-icon">‡</span><h3>Purpose-Driven Growth</h3><p>Every plan aligns with your goals and values — not just numbers — for impact that lasts.</p></article>
        <article><span class="about-value-icon">◎</span><h3>Stewardship &amp; Accountability</h3><p>We treat your goals with care, guiding decisions that protect today and empower tomorrow.</p></article>
        <article><span class="about-value-icon">▥</span><h3>Legacy Impact</h3><p>We help you build wealth with meaning — so the benefits outlive you and inspire generations.</p></article>
      </div>
    </div>
  </section>

</BaseLayout>
