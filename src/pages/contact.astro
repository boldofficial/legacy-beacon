---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../data/site";
const bookingIsExternal = site.bookingUrl.startsWith("http");
---

<BaseLayout
  title="Contact"
  description="Contact Legacy Beacon to ask a question or start a conversation about protection and legacy planning."
>
  <section class="editorial-page-hero contact-page-hero">
    <div class="container editorial-hero-grid">
      <div>
      <Breadcrumbs items={[{ label: "Contact" }]} />
      <h1>Start with a conversation.</h1>
      </div>
      <p>
        Tell us what you would like to understand. We will follow up using your
        preferred contact method.
      </p>
    </div>
  </section>
  <section class="editorial-page-section contact-page">
    <div class="container contact-page-grid">
      <aside class="contact-page-aside">
        <p class="page-section-label">Direct contact</p>
        <h2>Choose the way that feels easiest.</h2>
        <p class="contact-page-intro">
          Ask a question, share what you are exploring, or arrange a focused
          consultation about your family’s priorities.
        </p>
        <dl class="contact-details">
          <div>
            <dt>Call</dt>
            <dd>
              <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
            </dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
          <div>
            <dt>Consultation</dt>
            <dd>
              <a
                href={site.bookingUrl}
                target={bookingIsExternal ? "_blank" : undefined}
                rel={bookingIsExternal ? "noopener noreferrer" : undefined}
              >Book a consultation</a>
            </dd>
          </div>
        </dl>
        <div class="contact-social">
          <p class="page-section-label">Follow Legacy Beacon</p>
          <SocialLinks />
        </div>
        <p class="contact-privacy-note">
          <strong>Your privacy matters.</strong>
          Please do not send Social Security numbers, account numbers, medical
          details, or other sensitive information through this form.
        </p>
      </aside>
      <div class="contact-form-column">
        <div class="contact-form-heading">
          <p class="page-section-label">Send an enquiry</p>
          <h2>How can we help?</h2>
          <p>Required fields are marked with an asterisk.</p>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
