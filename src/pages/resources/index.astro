---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
const resources = (
  await getCollection("resources", ({ data }) => data.status === "published")
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Resources"
  description="Practical articles from Legacy Beacon about family protection, insurance, retirement, and legacy planning."
>
  <section class="editorial-page-hero resource-hero">
    <div class="container editorial-hero-grid">
      <div>
      <Breadcrumbs items={[{ label: "Resources" }]} />
      <h1>Knowledge for the decisions ahead</h1>
      </div>
      <p>
        Plain-language ideas to help families ask informed questions about
        protection, financial confidence, and legacy.
      </p>
    </div>
  </section>
  <section class="section resource-archive">
    <div class="container">
      <div class="resource-grid">
        {resources.map((item) => (
          <article class="editorial-card">
            <a class="editorial-card-image" href={`/resources/${item.id}`}>
              <img src={item.data.featuredImage} alt="" loading="lazy" />
            </a>
            <div class="editorial-card-body">
              <p class="resource-meta">
                {item.data.category} ·{" "}
                {item.data.publishDate.toLocaleDateString("en-US", {
                  month: "long",
                  day: "numeric",
                  year: "numeric",
                })}
              </p>
              <h2>
                <a href={`/resources/${item.id}`}>{item.data.title}</a>
              </h2>
              <p>{item.data.excerpt}</p>
              <a class="editorial-read" href={`/resources/${item.id}`}>Read article <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="resource-cta">
    <div class="container resource-cta-card">
      <div>
        <p class="eyebrow">Need tailored guidance?</p>
        <h2>Start with a conversation that fits your family’s priorities.</h2>
      </div>
      <div class="resource-cta-actions">
        <a class="btn btn-primary" href="/contact">Book a consultation</a>
        <a class="resource-cta-link" href="/services">Explore our services</a>
      </div>
    </div>
  </section>
</BaseLayout>
