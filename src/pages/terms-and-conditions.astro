---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout
  title="Terms and Conditions"
  description="Legacy Beacon SMS messaging terms and conditions, effective September 15, 2026."
>
  <header class="page-hero compact legal-page-hero">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: "Terms & Conditions" }]} />
      <p class="legal-kicker">SMS Messaging Terms and Conditions</p>
      <h1>Terms &amp; Conditions</h1>
      <p class="legal-effective"><strong>Effective date</strong> September 15, 2026</p>
    </div>
  </header>
  <main class="legal-page container narrow">
    <p class="legal-intro">By opting in to receive SMS messages from Legacy Beacon (also known as Legacy Beacon LLC.), you agree to these Terms and Conditions (“Terms”).</p>
    <section aria-labelledby="terms-service"><h2 id="terms-service">SMS Messaging Service</h2><p>By opting in to receive SMS messages from Legacy Beacon, you agree to receive conversational messages related to your direct communications with us.</p></section>
    <section aria-labelledby="terms-frequency"><h2 id="terms-frequency">Message Frequency</h2><p>Message frequency may vary. On average, you may receive 1–3 messages per month.</p></section>
    <section aria-labelledby="terms-rates"><h2 id="terms-rates">Message and Data Rates</h2><p>Message and data rates may apply based on your mobile carrier’s terms.</p></section>
    <section aria-labelledby="terms-consent"><h2 id="terms-consent">Consent</h2><p>Consent to receive SMS messages is not a condition of purchase.</p></section>
    <section class="legal-emphasis" aria-labelledby="terms-opt-out"><h2 id="terms-opt-out">Cancellation / Opt-Out Instructions</h2><p>You can opt out of receiving SMS messages at any time by replying <strong>STOP</strong>.</p></section>
    <section aria-labelledby="terms-help"><h2 id="terms-help">Help / Customer Support</h2><p>Reply <strong>HELP</strong> for assistance. You may also contact us at <a href="mailto:la@legacy-beacon.com">la@legacy-beacon.com</a>.</p></section>
    <section aria-labelledby="terms-privacy"><h2 id="terms-privacy">Privacy Policy</h2><p>Your information will be handled in accordance with our <a href="/privacy-policy">Privacy Policy</a>.</p></section>
    <section aria-labelledby="terms-liability"><h2 id="terms-liability">Liability</h2><p>We are not responsible for any charges, errors, delays in SMS delivery, or undelivered messages caused by your carrier or third-party service providers.</p></section>
  </main>
</BaseLayout>
