---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You"
  description="Your Legacy Beacon enquiry has been received."
  noindex={true}
>
  <section class="confirmation">
    <div class="container narrow center">
      <div class="confirmation-mark">✓</div>
      <p class="eyebrow">Message sent</p>
      <h1>Thank you for reaching out.</h1>
      <p class="section-lead">
        Your enquiry has been received. A member of the Legacy Beacon team will
        follow up using the contact details you provided.
      </p>
      <a class="text-link" href="/">
        Return home →
      </a>
    </div>
  </section>
</BaseLayout>
